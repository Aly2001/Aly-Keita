# Copiez ce fichier en « .env » (même dossier que manage.py) et remplissez-le.
# Le fichier .env n'est jamais envoyé sur GitHub.

# 1 = mode développement (messages d'erreur détaillés). Toujours 0 en ligne.
DJANGO_DEBUG=1

# Clé secrète Django. Pour en générer une :
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Adresses autorisées, séparées par des virgules (ex. en ligne : monnom.pythonanywhere.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Envoi des e-mails par Gmail (mot de passe d'application Google, jamais votre mot de passe principal).
# Laissés vides : les e-mails s'affichent dans le terminal au lieu de partir.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
